{
  "name": "wechat-crawler-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local WeChat article discovery, archival and retrieval MCP server",
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "bin": { "wechat-crawler-mcp": "dist/server/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "probe": "tsx scripts/probe.ts",
    "browser:login": "tsx scripts/browser-login.ts",
    "review:prepare": "tsx scripts/prepare-review.ts",
    "review:verify": "tsx scripts/verify-review.ts",
    "test:browser": "tsx scripts/run-browser-tests.ts"
  },
  "dependencies": {
    "@jackwener/opencli": "2.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "1.2.0",
    "playwright-core": "1.64.1",
    "turndown": "7.2.2",
    "zod": "4.6.7"
  },
  "overrides": { "undici": "7.30.1" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/turndown": "5.0.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
